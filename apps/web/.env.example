# Copy to .env.local for local development. .env* is git-ignored (see
# .gitignore) — never commit a real .env* file.

# Base URL of the Impulso API, including its versioned prefix. Must match
# apps/api's own API_V1_PREFIX (default "/api/v1") and the port your local
# `uvicorn app.main:app --reload` is actually listening on (default 8000).
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
