# Copy this file to .env for local development.
# .env is git-ignored — never commit real values here.
# There are no real secrets in this stage: no authentication and no AI
# provider credentials exist yet. DATABASE_URL below is a fake local
# placeholder (a throwaway local Postgres role/password you create
# yourself), not a real credential.

APP_NAME=Impulso API
APP_ENV=development
API_V1_PREFIX=/api/v1
DEBUG=true

# Comma-separated list of allowed frontend origins. Must never contain "*".
CORS_ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL connection string (SQLAlchemy + psycopg 3 driver).
# No default is provided anywhere in code — see app/core/config.py.
# Placeholder only; point this at your own local development database.
DATABASE_URL=postgresql+psycopg://impulso_dev:impulso_dev@localhost:5432/impulso_dev

# A SEPARATE, dedicated database for running tests — must never be the
# same database as DATABASE_URL above. Its name must contain "_test" and
# its host must be local (see app/persistence/testing.py); anything else
# is refused before any destructive test operation runs.
TEST_DATABASE_URL=postgresql+psycopg://impulso_dev:impulso_dev@localhost:5432/impulso_dev_test

# A THIRD, separate database used only by the Alembic migration
# round-trip tests (tests/test_migrations.py) — kept apart from
# TEST_DATABASE_URL so Alembic's own bookkeeping never collides with the
# transaction tests' direct table management of the same schema.
TEST_MIGRATIONS_DATABASE_URL=postgresql+psycopg://impulso_dev:impulso_dev@localhost:5432/impulso_dev_test_migrations
