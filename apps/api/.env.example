# Copy this file to .env for local development.
# .env is git-ignored — never commit real values here.
# There are no secrets to configure in this stage (no database, no
# authentication, no AI provider credentials exist yet).

APP_NAME=Impulso API
APP_ENV=development
API_V1_PREFIX=/api/v1
DEBUG=true

# Comma-separated list of allowed frontend origins. Must never contain "*".
CORS_ALLOWED_ORIGINS=http://localhost:3000
